{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "build:client": "cd client && npm run build",
    "start": "node server/server.js",
    "seed:developer": "node server/scripts/seedDeveloper.js",
    "reconcile:voice-audio": "node server/scripts/reconcileVoiceAudioFiles.js",
    "smoke:dev-auth": "node server/scripts/smokeDevAuth.js",
    "audit:tenant": "node server/scripts/auditTenantQueries.js",
    "dev": "node server/server.js",
    "start:prod": "node --max-old-space-size=2048 server/server.js",
    "perf:smoke": "node server/scripts/smoke-load.mjs",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop school-saas-server school-saas-client",
    "restart:pm2": "pm2 restart school-saas-server school-saas-client",
    "logs:pm2": "pm2 logs school-saas-server school-saas-client",
    "status:pm2": "pm2 status",
    "check:server": "node scripts/checkServer.js",
    "backup:db": "node server/scripts/mongoBackup.js",
    "backup:cron": "node server/scripts/backupCron.js",
    "restore:test": "node server/scripts/mongoRestoreTest.js",
    "qa:ui:crawl": "node scripts/ui-crawler.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "playwright": "^1.58.2",
    "pm2": "^6.0.8",
    "tailwind": "^4.0.0"
  }
}
